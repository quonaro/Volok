#!/bin/sh /etc/rc.common
# Volok init script for OpenWrt (procd)

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/volok
CONF=/etc/volok/volok.json

start_service() {
	procd_open_instance
	procd_set_param command "$PROG" --file "$CONF" serve
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param pidfile /var/run/volok.pid
	procd_close_instance
}
