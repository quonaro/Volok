app:
  shutdown_gracetime: 10s
  http_port: 41220
  external_host: localhost
  singbox_log_level: warn
  log_level: info
  disable_docs: false
  secure_cookies: false  # set true behind HTTPS reverse proxy
  pprof_enabled: false
  pprof_bind: 127.0.0.1:6060
  cors:
    allowed_origins: []
  country_lookup:
    check_interval: 30s
    batch_size: 50
    retry_delay: 10m
    provider_timeout: 10s
jwt:
  secret: CHANGE_ME_IN_PRODUCTION
  expiry: 24h0m0s
database: ./outless.db
inbounds:
  vless:
    enable: true
    listen: 0.0.0.0
    port: 443
    sni: example.com
    handshake: example.com
    private_key: ""   # base64 x25519 private key (use outless keypair command to generate)
    short_id: ""      # 16-char hex string
    fingerprint: chrome
    name_template: ""
  mixed:
    enable: false
    listen: 0.0.0.0
    port: 1080
